+def with_source_page(source_url, page):
+    """Make a TMDb Helper source pageable instead of retaining widget-only limits."""
+    parsed = urlparse(source_url or '')
+    if parsed.scheme != 'plugin' or parsed.netloc != 'plugin.video.themoviedb.helper':
+        return ''
+    query = parse_qs(parsed.query, keep_blank_values=True)
+    # Existing homepage widgets can be explicitly single-page and/or use
+    # cacheonly mode. Both prevent normal exploration beyond their first page.
+    query.pop('nextpage', None)
+    query.pop('cacheonly', None)
+    query.pop('length', None)
+    query.pop('limit', None)
+    query['widget'] = ['false']
+    query['page'] = [str(max(1, int(page)))]
+    return parsed._replace(query=urlencode(query, doseq=True)).geturl()
+
+
+def get_source_page_url(entry):
+    """Follow the real TMDb Helper next-page directory where available."""
+    if not isinstance(entry, dict):
+        return ''
+    label = str(entry.get('label') or entry.get('title') or '').strip().lower()
+    url = str(entry.get('file') or '')
+    if not url.startswith('plugin://plugin.video.themoviedb.helper/'):
+        return ''
+    if ('next page' in label or 'nextpage' in label or label.startswith('next ')):
+        return url
+    return ''
+
 
