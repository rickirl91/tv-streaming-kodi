<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.video.streamrow" name="TV Streaming StreamRow" version="0.3.2" provider-name="Local TV setup">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="plugin.video.themoviedb.helper" version="0.0.0"/>
        <import addon="script.tvstreaming.lazywall" version="0.2.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Prototype of a See All-first movie widget.</summary>
        <description lang="en_GB">A non-destructive test: prepends See All to TMDb Helper Action movie results. Does not change your skin, players or TMDb Helper settings.</description>
        <platform>all</platform>
        <license>MIT</license>
        <assets>
            <icon>resources/media/see_all_miami_neutral_v024.png</icon>
        </assets>
    </extension>
</addon>
