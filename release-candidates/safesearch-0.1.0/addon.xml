<?xml version="1.0" encoding="UTF-8"?>
<addon id="script.tvstreaming.safesearch" name="TV Streaming - Cricky Safe Search (RC)" version="0.1.0" provider-name="TV Streaming">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
    <import addon="plugin.video.themoviedb.helper" />
  </requires>
  <extension point="xbmc.python.script" library="default.py" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Reversible Cricky-only Home Search route</summary>
    <description lang="en_GB">Uses native Kodi keyboard and TMDb Helper combined title search instead of Arctic Fuse 3 multisearch. Explicit apply and exact backup restore. No service.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
